<Window x:Class="AudioMixer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioMixer Platform" Height="760" Width="1180"
        MinHeight="620" MinWidth="900" Background="#FF171A22" Foreground="#FFF3F4F8">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="AUDIOMIXER" FontSize="23" FontWeight="Bold" />
                <TextBlock Text="Локальная панель управления" Foreground="#FF9AA3B7" Margin="0,3,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#FF3A3021" CornerRadius="8" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="Движок не подключён · прототип UI" Foreground="#FFFFD38A" />
            </Border>
        </DockPanel>
        <Border Grid.Row="1" Background="#FF2C3140" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <TextBlock TextWrapping="Wrap" Foreground="#FFD7DCE8">
                Сейчас это только интерфейсный каркас. Управление аудиодвижком, захват приложений и виртуальные выходы ещё не подключены — элементы ниже не притворяются работающими регуляторами.
            </TextBlock>
        </Border>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="МИКСЫ" FontSize="13" FontWeight="SemiBold" Foreground="#FF9AA3B7" Margin="2,0,0,10" />
                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="PERSONAL · наушники" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Выход и уровень появятся после подключения Host API." Foreground="#FF9AA3B7" Margin="0,8,0,0" />
                            <ProgressBar Height="8" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="0" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="STREAM · OBS" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Stream endpoint и meter пока не подключены." Foreground="#FF9AA3B7" Margin="0,8,0,0" />
                            <ProgressBar Height="8" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="0" IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <DockPanel Margin="2,0,0,10">
                    <TextBlock Text="КАНАЛЫ" FontSize="13" FontWeight="SemiBold" Foreground="#FF9AA3B7" />
                    <TextBlock DockPanel.Dock="Right" Text="Источники появятся после подключения движка" Foreground="#FF7F899F" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Channels}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" />
                                        <TextBlock Text="Нет источников" Foreground="#FF7F899F" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,0">
                                        <TextBlock Text="PERSONAL" Foreground="#FF9AA3B7" FontSize="11" />
                                        <Slider Minimum="0" Maximum="150" IsEnabled="False" />
                                        <CheckBox Content="Mute Personal" IsEnabled="False" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="12,0">
                                        <TextBlock Text="STREAM" Foreground="#FF9AA3B7" FontSize="11" />
                                        <Slider Minimum="0" Maximum="150" IsEnabled="False" />
                                        <CheckBox Content="Mute Stream" IsEnabled="False" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="3" Background="#FF222633" CornerRadius="8" Padding="10" Margin="0,12,0,0">
            <TextBlock Text="Сборки выполняются в GitHub Actions; локальные SDK и Android Studio для облачной сборки не требуются." Foreground="#FF9AA3B7" />
        </Border>
    </Grid>
</Window>
